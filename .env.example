# ==============================================================================
# Apotek Sri Redjeki Farma - Environment Variables Template
# Salin file ini menjadi .env atau .env.local dan isi dengan kredensial proyek Supabase Anda.
# JANGAN PERNAH meng-commit file .env atau .env.local ke repositori publik!
# ==============================================================================

# Client / Frontend Environment Variables (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Server / Direct Database (Hanya untuk migrasi CLI lokal / pgAdmin, opsional)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

